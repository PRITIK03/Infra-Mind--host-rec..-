API_KEY=
BASE_URL=
MODEL_NAME=
VANTAGE_API_KEY=
TAVILY_API_KEY=
LLM_MAX_TOKENS=8192
# Caps the model's internal "thinking" budget specifically — separate from
# the overall response budget — to prevent reasoning-heavy models from
# consuming the entire max_tokens before producing visible output.
# This is a subset of LLM_MAX_TOKENS, not additional to it.
# The client maps this ratio onto OpenRouter reasoning.effort (low/medium/…)
# because OpenRouter rejects setting both effort and max_tokens, and several
# free-router models ignore reasoning.max_tokens.
LLM_REASONING_MAX_TOKENS=2048
# Optional second OpenRouter key for automatic rate-limit failover
API_KEY_2=

# Optional comma-separated list of OpenRouter model slugs to use as
# server-side fallbacks when the primary model (MODEL_NAME) is rate-limited
# or unavailable. OpenRouter tries each model in order before failing.
# This is additive to API_KEY_2 failover: keys handle per-account quotas,
# this handles per-model congestion. Leave empty to disable.
# Example free-tier models suited for structured JSON output:
# LLM_FALLBACK_MODELS=meta-llama/llama-3.1-70b-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-2-9b-it:free
LLM_FALLBACK_MODELS=

# FastAPI HTTP layer (app/api/main.py). Set the real deployed frontend origin
# in production; there is intentionally no localhost fallback.
CORS_ALLOWED_ORIGIN=http://localhost:3000
PORT=8000
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
